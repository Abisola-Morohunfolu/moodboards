# Copy to .env. R2 credentials must be created in Cloudflare; other values are local defaults.

# Postgres
POSTGRES_DB=moodboard
POSTGRES_USER=moodboard
POSTGRES_PASSWORD=moodboard
POSTGRES_PORT=5432
DATABASE_URL=postgres://moodboard:moodboard@localhost:5432/moodboard
DB_POOL_MAX=10
# Export this value before database tests. Tests never use DATABASE_URL as a fallback.
TEST_DATABASE_URL=postgres://moodboard_test:moodboard_test@127.0.0.1:5433/moodboard_test

# Redis: authentication rate limits and BullMQ queues; future pub/sub
REDIS_PORT=6379
REDIS_URL=redis://127.0.0.1:6379
REDIS_MAXMEMORY=256mb
# Disposable Redis service. Tests require database 15 and never fall back to REDIS_URL.
TEST_REDIS_PORT=6380
TEST_REDIS_URL=redis://127.0.0.1:6380/15

# Private Cloudflare R2 Standard storage. Enable R2 and create a bucket first.
# Uncomment all four fields with real credentials to enable media (see docs/15-backend-media-workers.md).
# R2_ACCOUNT_ID=
# R2_BUCKET=moodboard-assets
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=

# Email (Mailpit). Inbox at http://localhost:8025
SMTP_PORT=1025
MAILPIT_UI_PORT=8025
SMTP_URL=smtp://localhost:1025

# Share and client link tokens are HMAC(LINK_SECRET, id:link_version). Changing it ends every link.
LINK_SECRET=local-only-change-me

# App ports
WEB_PORT=3000
API_PORT=3001
API_HOST=127.0.0.1

# Stripe test mode. Needed only for: docker compose --profile stripe up
# The CLI prints a webhook signing secret on start; put it in STRIPE_WEBHOOK_SECRET.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_WEBHOOK_FORWARD_TO=http://host.docker.internal:3001/webhooks/stripe

# Account authentication. Comma-separated browser origins, no trailing slash.
# Production requires explicit HTTPS origins. Cookies are Secure in production.
AUTH_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# Leave all three Google fields unset to disable Google sign-in locally.
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GOOGLE_CALLBACK_URL=http://127.0.0.1:3001/auth/google/callback

# Media workers (10 MiB uniform per-file cap, no paid entitlements yet)
MEDIA_UPLOAD_MAX_BYTES=10485760
WORKER_HOST=127.0.0.1
WORKER_PORT=3002
# Tests explicitly target disposable MinIO; never use R2 credentials.
TEST_STORAGE_ENDPOINT=http://127.0.0.1:9002
TEST_STORAGE_BUCKET=moodboard-test-assets
