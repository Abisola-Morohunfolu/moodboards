# Copy to .env. Every value here is for local development only.

# Postgres
POSTGRES_DB=moodboard
POSTGRES_USER=moodboard
POSTGRES_PASSWORD=moodboard
POSTGRES_PORT=5432
DATABASE_URL=postgres://moodboard:moodboard@localhost:5432/moodboard

# Redis: pub/sub and BullMQ queues
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379

# Object storage (MinIO, S3-compatible). Console at http://localhost:9001
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=moodboard-assets
S3_ACCESS_KEY=moodboard
S3_SECRET_KEY=moodboard-local-secret
S3_FORCE_PATH_STYLE=true

# Email (Mailpit). Inbox at http://localhost:8025
SMTP_PORT=1025
MAILPIT_UI_PORT=8025
SMTP_URL=smtp://localhost:1025

# Share and client link tokens are HMAC(LINK_SECRET, id:link_version). Changing it ends every link.
LINK_SECRET=local-only-change-me

# App ports
WEB_PORT=3000
API_PORT=3001

# Stripe test mode. Needed only for: docker compose --profile stripe up
# The CLI prints a webhook signing secret on start; put it in STRIPE_WEBHOOK_SECRET.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_WEBHOOK_FORWARD_TO=http://host.docker.internal:3001/webhooks/stripe
