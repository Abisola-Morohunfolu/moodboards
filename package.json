{
  "name": "moodboard",
  "private": true,
  "version": "0.0.0",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "build": "pnpm -r build",
    "typecheck": "tsc --noEmit && pnpm --filter @moodboard/web typecheck",
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "eslint . --fix --max-warnings 0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "dev:api": "pnpm build && pnpm --filter @moodboard/api dev",
    "dev:web": "pnpm --filter @moodboard/web dev",
    "start:api": "pnpm --filter @moodboard/api start",
    "db:migrate": "pnpm build && node apps/api/dist/database/cli.js run",
    "db:status": "pnpm build && node apps/api/dist/database/cli.js status",
    "db:revert": "pnpm build && node apps/api/dist/database/cli.js revert",
    "db:test:start": "docker compose -f compose.test.yaml up -d --wait",
    "db:test:stop": "docker compose -f compose.test.yaml down",
    "test:unit": "jest --config jest.config.cjs --selectProjects unit --runInBand",
    "test:integration": "jest --config jest.config.cjs --selectProjects integration --runInBand",
    "test:e2e": "jest --config jest.config.cjs --selectProjects e2e --runInBand",
    "check": "pnpm format:check && pnpm lint && pnpm build && pnpm typecheck && pnpm test:unit && pnpm test:integration && pnpm test:e2e",
    "dev:worker": "pnpm build && pnpm --filter @moodboard/worker dev",
    "start:worker": "pnpm --filter @moodboard/worker start",
    "storage:smoke:r2": "pnpm build && node --env-file=.env scripts/smoke-r2.mjs"
  },
  "devDependencies": {
    "@aws-sdk/client-s3": "3.1146.0",
    "@eslint/js": "9.39.1",
    "@nestjs/common": "11.2.7",
    "@nestjs/config": "4.0.4",
    "@nestjs/testing": "11.2.7",
    "@types/jest": "30.0.0",
    "@types/node": "24.10.1",
    "@types/pg": "8.15.5",
    "@types/supertest": "6.0.3",
    "eslint": "9.39.1",
    "eslint-config-prettier": "10.1.8",
    "jest": "30.5.2",
    "pg": "8.16.3",
    "prettier": "3.9.9",
    "sharp": "0.35.5",
    "supertest": "7.1.4",
    "ts-jest": "29.4.14",
    "typeorm": "0.3.31",
    "typescript": "5.9.3",
    "typescript-eslint": "8.71.0"
  }
}
