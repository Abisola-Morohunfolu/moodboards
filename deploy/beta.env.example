# Copy to .env.beta; chmod 600 .env.beta. Never commit secrets.
RELEASE_IMAGE=moodboard:beta-REPLACE_WITH_COMMIT_SHA
WEB_DOMAIN=boards.example.com
API_DOMAIN=api.example.com
# Use the same registrable domain for Secure SameSite=Lax account cookies.
SUPPORT_EMAIL=
# Use separate hex secrets (openssl rand -hex 32) so URLs need no password escaping.
POSTGRES_PASSWORD=
REDIS_PASSWORD=
BETA_SIGNUP_EMAILS=
LINK_SECRET=
R2_ACCOUNT_ID=
R2_BUCKET=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
MEDIA_UPLOAD_MAX_BYTES=10485760
DB_POOL_MAX=10
# Google sign-in remains unset and unadvertised for private beta.
